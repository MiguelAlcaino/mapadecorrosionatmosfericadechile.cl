# ── Symfony 1.x: runtime ──
/cache/
/log/
/logs/
/tmp/

# ── Backups / archivos enormes ──
apps.zip
*.zip
*.tar
*.tar.gz
*.gz

# ── Imágenes / datos (viven en el servidor, no en git) ──
/public_html/uploads/
/public_html/imagenes/
/public_html/images/mapas/

# ── SENSIBLE: credenciales ──
/config/databases.yml
/config/properties.ini

# ── Cruft de cPanel / servidor ──
/access-logs/
/ssl/
/etc/
/perl5/
/data/sql/
cpbackup-exclude.conf
dailyreport_off
delay_spam_lover
s_imapstatus

# ── Logs sueltos ──
error_log
**/error_log
*.log

# ── Docker: dump cargado en init + archivos sueltos del transfer ──
/docker/db/init/
gitstatus.txt
config/rsync_exclude.txt

# ── SO / editor ──
.DS_Store
Thumbs.db
*.sw?
*~
.idea/
.vscode/

# Composer deps (reproduced via composer install)
/vendor/

# Override de compose específico por entorno (dev: db en contenedor / prod Pi: db en host)
/docker-compose.override.yml
